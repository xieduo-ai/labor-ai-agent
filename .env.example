# 复制为 .env 后填入密钥（.env 已在 .gitignore 中，不要提交）
# 本项目默认使用硅基流动 SiliconFlow：生成 / 向量 / 重排 / 视觉模型共用一个 Key。

# ---- 生成模型（法规问答、合同审查）----
LLM_API_KEY=sk-你的硅基流动密钥
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3

# ---- 视觉模型（合同照片 / 扫描件识别）----
# Qwen2.5-VL 系列已下线，写旧模型名会直接 403；可用模型可用 tools/list_models.py 查
LLM_VL_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
VL_MAX_PAGES=3        # 扫描版 PDF 最多识别几页
VL_MAX_SIDE=1600      # 图片长边压缩上限（px），控制 token 与耗时

# ---- Agent 专用模型 ----
# 实测 DeepSeek-V3 在硅基流动不总是走原生 tool_calls（会把调用写进正文 JSON），
# V3.1 稳定返回原生 tool_calls，所以 Agent 单独指定模型。
# 改回 deepseek-ai/DeepSeek-V3 会导致「假工具调用」，请勿随意替换。
AGENT_MODEL=deepseek-ai/DeepSeek-V3.1

# ---- 向量化 + 重排 ----
EMBED_API_KEY=sk-你的硅基流动密钥
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 重排开关：调不通就设 0，只靠混合检索也能跑
USE_RERANK=1

# ---- 生产部署 ----
# Railway 会注入 PORT，不需要在这里写
# 前端构建期变量在 frontend/.env.local：NEXT_PUBLIC_API_BASE=https://<后端域名>
